FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg postgresql && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/ranger-duck/backend /app/apps/ranger-duck/backend
COPY services/archive /app/services/archive
RUN pip install --no-cache-dir -e './services/archive[test]' -e './apps/ranger-duck/backend[test]'
COPY . /app
CMD ["bash", "services/archive/test-integration.sh"]
