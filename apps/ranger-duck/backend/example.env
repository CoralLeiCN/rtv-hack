# Copy to .env in this directory and fill in privately. Never commit real values.
# The backend loads .env automatically; exported environment variables take precedence.
# INGRESS_URL must include https:// (or http:// for a local service).
# Quote values containing spaces or #. ${...} is kept literal, not expanded.
INGRESS_URL=
USERNAME=
PASSWORD=
RANGER_REFERENCE_MANIFEST=
RANGER_STATIC_DIR=
RANGER_SEARCH_TIMEOUT_SEC=30
RANGER_REQUEST_TIMEOUT_SEC=10
RANGER_CLIP_TTL_SEC=1800
RANGER_SECURE_COOKIE=false
