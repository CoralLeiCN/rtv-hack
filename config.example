# Copy to an ignored .env; fill in privately. Never commit real values.
ARCHIVE_URL=http://127.0.0.1:18001
ARCHIVE_API_KEY=
# Neon Postgres URL with sslmode=require. API may use the pooled URL.
DATABASE_URL=
# REQUIRED for Neon workers: direct URL, without -pooler in hostname.
WORKER_DATABASE_URL=
# Only for compose.local.yml; use a generated local password in both database URLs.
POSTGRES_PASSWORD=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=microduck_embeddinggemma2_768
MEDIA_ROOT=./media
EMBEDDING_MODEL=google/embeddinggemma-2
# Pin to a reviewed Hugging Face commit before importing the real collection.
EMBEDDING_REVISION=main
EMBEDDING_DEVICE=cpu
COSMOS_URL=http://127.0.0.1:8002/v1
# Must match /v1/models on your self-hosted reasoner.
COSMOS_MODEL=nvidia/Cosmos3-Nano
COSMOS_REVISION=main
COSMOS_API_KEY=
