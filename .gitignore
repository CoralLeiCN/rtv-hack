# --- root .md files: whitelist, not blacklist ---
# Only the repository overview and agent instructions are kept at the root.
# Hackathon documents live in docs/hackathon/. New root .md files are internal
# by default and must be explicitly un-ignored below to ship. Doesn't affect
# .cursor/ or .agents/, where Markdown files contain shipped agent guidance.
/*.md
!/README.md
!/AGENTS.md

# --- internal / agent context (not for attendees) ---
.claude/

# --- secrets & real per-team configs (keep only *.example tracked) ---
.env
.env.*
!.env.example
*.config
!*.config.example
secrets.yaml
secrets.*.yaml
config.yaml
*-config.yaml
!config.example
!*.example.yaml

# --- python ---
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
.ipynb_checkpoints/

# --- os / editor junk ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- misc local ---
*.log
tmp/
resp.json

# --- organizer verification script (internal) ---
verify-vm.sh

# --- live screen ---
screen/
