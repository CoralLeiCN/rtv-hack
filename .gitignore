# --- root .md files: whitelist, not blacklist ---
# Keep the overview and agent instructions at the root.
# Other root Markdown files are internal unless explicitly allowed below.
# Product and operational documentation belongs in docs/.
/*.md
!/README.md
!/AGENTS.md

# --- local agent context ---
.claude/

# --- secrets and local service configs (keep only examples tracked) ---
.env
.env.*
!.env.example
*.config
!*.config.example
secrets.yaml
secrets.*.yaml
config.yaml
*-config.yaml
!config.example
!*.example.yaml

# --- python ---
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
.ipynb_checkpoints/

# --- os / editor junk ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- misc local ---
*.log
tmp/
resp.json
.captures/
/research/

# --- local verification script ---
verify-vm.sh

# --- live screen ---
screen/

/media/
.qdrant/
*.egg-info/
